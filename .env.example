# Environment variables for Banking Support AI Agent Chatbot
# Copy this file to .env and update values for your environment

# ============================================
# FastAPI Configuration
# ============================================
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true
LOG_LEVEL=info

# ============================================
# Streamlit Configuration
# ============================================
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
STREAMLIT_ENABLE_CORS=true
STREAMLIT_ENABLE_XSRF=false

# ============================================
# Weaviate Vector Database
# ============================================
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=sqlite:///./banking_chatbot.db
DATABASE_ECHO=false

# ============================================
# LLM Configuration
# ============================================
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_API_KEY=your_api_key_here

# ============================================
# RAG Configuration
# ============================================
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================
# Agent Configuration
# ============================================
AGENT_MAX_MEMORY_SIZE=10
AGENT_CONFIDENCE_THRESHOLD=0.5

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================
# Security Configuration (Production)
# ============================================
SECRET_KEY=your_secret_key_here_change_in_production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com

# ============================================
# Feedback Configuration
# ============================================
FEEDBACK_STORAGE_PATH=data/feedback
FEEDBACK_EMAIL=support@banking-chatbot.com

# ============================================
# Document Configuration
# ============================================
DOCUMENT_STORAGE_PATH=data/documents
DOCUMENT_MAX_FILE_SIZE=52428800  # 50MB in bytes

# ============================================
# Cache Configuration
# ============================================
CACHE_ENABLED=true
CACHE_TTL=3600  # 1 hour in seconds

# ============================================
# Development/Testing
# ============================================
TESTING=false
DEVELOPMENT=false
MOCK_LLM=false
